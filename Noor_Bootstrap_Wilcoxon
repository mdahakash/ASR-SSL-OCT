{"metadata":{"kernelspec":{"display_name":"Python 3","language":"python","name":"python3"},"language_info":{"name":"python","version":"3.13.16","mimetype":"text/x-python","codemirror_mode":{"name":"ipython","version":3},"pygments_lexer":"ipython3","nbconvert_exporter":"python","file_extension":".py"},"jupytext":{"formats":"md,ipynb"},"kaggle":{"accelerator":"nvidiaTeslaT4","dataSources":[{"sourceType":"datasetVersion","sourceId":18165758}],"isInternetEnabled":true,"language":"python","sourceType":"notebook","isGpuEnabled":false}},"nbformat_minor":5,"nbformat":4,"cells":[{"id":"031291c4","cell_type":"markdown","source":"# TRIAGE — Reviewer #1 M2 Statistical Runner (Single-Seed Per Run, Multi-Seed Merger)\n\nClean, self-contained Kaggle notebook built specifically to answer **Reviewer #1 Major 2 (`M2`) & Question 3 (`Q3`)** under your exact Option B split (`heldout_calib`, Manuscript Table 1):\n\n### How to Run 3 Seeds Cleanly Across 3 Sessions\n1. **Session 1:** Keep `MODEL_SEED = 12` $\\rightarrow$ Run All $\\rightarrow$ Save Kaggle Output (e.g. `m2-seed12`).\n2. **Session 2:** Change ONLY `MODEL_SEED = 111` $\\rightarrow$ Run All $\\rightarrow$ Save Kaggle Output (e.g. `m2-seed111`).\n3. **Session 3:** Change ONLY `MODEL_SEED = 165`, attach Session 1 & 2 outputs in `PREVIOUS_SEED_DIRS`, and Run All.\n\n### Why This Fixes the Old Notebook's Bug\n- **`SPLIT_SEED = 12` is permanently locked** — changing `MODEL_SEED` (`12` $\\rightarrow$ `111` $\\rightarrow$ `165`) **never** changes the 33 test patients (3,512 B-scans, 116 volumes). Every seed is evaluated on the exact same patients, volumes, and scans.\n- Automatically computes **ALL M2 outputs**:\n  - **Seed-wise breakdown** (`12`, `111`, `165`, `Mean ± Std`) + `m2_seedwise_table.tex`\n  - **$B = 2,000$ Patient-Cluster Bootstrap 95% CIs** ($N = 33$ patient clusters, pooling constituent scans/volumes and averaging replicates across available seeds)\n  - **Paired Patient-Level Two-Sided Wilcoxon Signed-Rank Tests** ($N = 33$ patients for Accuracy/Vol Accuracy; $N_{\\text{diseased}}$ for Scan/Vol UGR, averaged across seeds per patient) reporting exact **`N_total`**, non-tied **`N_eff`**, raw **`p_raw`**, and **Holm–Bonferroni `p_adj`**\n  - Both **TRIAGE vs. All Comparators (including `Supervised 100%`)** and **All Pairwise Baseline Comparisons (`M × (M-1) / 2`)** exported as CSV/JSON + ready-to-paste **`m2_Supplementary_Table_S1.tex`**","metadata":{}},{"id":"b7b7d1d8","cell_type":"code","source":"# ==============================================================================\n# Cell 1 — Single-Seed Control Panel (EDIT ONLY THESE SETTINGS PER RUN)\n# ==============================================================================\nimport os\n\n# ── 1. Change ONLY this seed across your 3 runs: 12 -> 111 -> 165 ─────────────\nMODEL_SEED = 12\n\n# ── 2. Choose baseline scope & step budget ─────────────────────────────────────\n#   'essential' : TRIAGE + Sup(100%) + FlexMatch + CoMatch + FixMatch\n#   'all_m2'    : TRIAGE + Sup(100%) + all 7 Table-4 comparators (Flex, Co, Fix, Free, MT, PL, Sup20)\nBASELINE_SET = 'all_m2'\n\n# Optional: include Reviewer 1 M4's full-arch Fixed-threshold (0.95) ablation\nINCLUDE_M4_FIXED_ABLATION = False\n\n# Optional: set TOTAL_STEPS = 1024 * 4 and EVAL_STEP = 512 for 2.5x faster runs (same step parity for all!)\nTOTAL_STEPS = 1024 * 10\nEVAL_STEP   = 1024\n\n# ── 3. Speed & Hardware Settings (Zero math change; ~4x-6x faster on Kaggle) ───\nUSE_AMP               = True   # Mixed precision (FP16 Tensor Cores on CUDA T4)\nPRELOAD_IMAGES_TO_RAM = True   # Decodes/resizes all 16,822 images once into RAM (~3.5 GiB of 30 GB)\nNUM_WORKERS           = 4      # Matches v2-89-66 (4 parallel DataLoader workers)\n\n# ── 4. Paths & Previous Session Outputs (For Merging Seeds 12 + 111 + 165) ─────\nLOCAL_MODE = False\nOUTPUT_DIR = '/kaggle/working/m2_outputs' if not LOCAL_MODE else './m2_outputs'\n\n# In Run 2 or Run 3, add your previous Kaggle Output dataset directories here:\n# Example in Run 3: ['/kaggle/input/m2-seed12', '/kaggle/input/m2-seed111']\nPREVIOUS_SEED_DIRS = []\n\n# Optional: run Cell 5 statistics ONLY (skipping training) if all 3 seed CSVs are already in PREVIOUS_SEED_DIRS\nSTATS_ONLY_MODE = False\nSKIP_IF_DONE    = True\n\n# ── Locked Split & Reproducibility Constants (DO NOT EDIT) ─────────────────────\nSPLIT_SEED       = 12               # Locked Option B split across ALL seeds!\nSPLIT_SCHEME     = 'heldout_calib'  # Table 1 exact: 2329 / 9012 / 563 / 1406 / 3512\nBOOTSTRAP_B      = 2000\nBOOTSTRAP_SEED   = 2026\nVOL_POOL_PRIMARY = 'risk_sensitive' # Primary volume pooling ('risk_sensitive' or 'mean')\n\n_BASE_LIST = (\n    ['triage', 'sup_100', 'flexmatch', 'comatch', 'fixmatch']\n    if BASELINE_SET == 'essential'\n    else ['triage', 'sup_100', 'flexmatch', 'comatch', 'fixmatch', 'freematch', 'meanteacher', 'pseudolabel', 'sup_only']\n)\nif INCLUDE_M4_FIXED_ABLATION:\n    _BASE_LIST.insert(1, 'ablation_fixed_full')\n\nMETHODS_TO_RUN = _BASE_LIST\nos.makedirs(OUTPUT_DIR, exist_ok=True)\nprint(f'MODEL_SEED={MODEL_SEED} | SPLIT_SEED={SPLIT_SEED} ({SPLIT_SCHEME}) | BASELINE_SET={BASELINE_SET}')\nprint(f'METHODS ({len(METHODS_TO_RUN)}): {METHODS_TO_RUN}')\nprint(f'OUTPUT_DIR={os.path.abspath(OUTPUT_DIR)} | PREVIOUS_SEED_DIRS={PREVIOUS_SEED_DIRS}')","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-11-25T15:28:35.07301Z","iopub.execute_input":"2026-11-25T15:28:35.073747Z","iopub.status.idle":"2026-11-25T15:28:35.085408Z","shell.execute_reply.started":"2026-11-25T15:28:35.073717Z","shell.execute_reply":"2026-11-25T15:28:35.084622Z"}},"outputs":[{"name":"stdout","text":"MODEL_SEED=12 | SPLIT_SEED=12 (heldout_calib) | BASELINE_SET=all_m2\nMETHODS (9): ['triage', 'sup_100', 'flexmatch', 'comatch', 'fixmatch', 'freematch', 'meanteacher', 'pseudolabel', 'sup_only']\nOUTPUT_DIR=/kaggle/working/m2_outputs | PREVIOUS_SEED_DIRS=[]\n","output_type":"stream"}],"execution_count":1},{"id":"1132dbc5","cell_type":"markdown","source":"## Cell 2 — Setup, Locked Option B Split (`SPLIT_SEED = 12`), & Transforms\n\nVerifies patient disjointness across all 5 Noor splits and decouples `set_model_seed(MODEL_SEED)` from `SPLIT_SEED = 12`.","metadata":{}},{"id":"513788d9","cell_type":"code","source":"import gc, glob, json, math, psutil, random, time, warnings\nfrom copy import deepcopy\nfrom collections import defaultdict\nfrom concurrent.futures import ThreadPoolExecutor\n\nimport cv2\nimport numpy as np\nimport pandas as pd\nfrom PIL import Image\nimport PIL.ImageOps, PIL.ImageEnhance, PIL.ImageDraw\n\nimport torch\nimport torch.nn as nn\nimport torch.nn.functional as F\nimport torchvision.models as tvm\nimport torchvision.transforms as T\nfrom torch.utils.data import Dataset, DataLoader, RandomSampler, SequentialSampler\nfrom torch.optim.lr_scheduler import LambdaLR\n\nfrom scipy import stats as scipy_stats\nfrom sklearn.model_selection import GroupShuffleSplit\nfrom sklearn.metrics import accuracy_score, precision_score, recall_score, f1_score, roc_auc_score, confusion_matrix\nfrom tqdm.auto import tqdm\n\nwarnings.filterwarnings('ignore')\ncv2.setNumThreads(0)\ntorch.backends.cuda.matmul.allow_tf32 = True\ntorch.backends.cudnn.allow_tf32 = True\nDEVICE = torch.device('cuda:0' if torch.cuda.is_available() else 'cpu')\nPIN_MEMORY   = (DEVICE.type == 'cuda')\nUSE_CUDA_AMP = bool(USE_AMP and DEVICE.type == 'cuda')\n\ndef set_model_seed(seed: int):\n    random.seed(seed)\n    np.random.seed(seed)\n    torch.manual_seed(seed)\n    torch.cuda.manual_seed_all(seed)\n    torch.backends.cudnn.benchmark = True\n\nNUM_CLASSES = 3\nCLASSES     = ['NORMAL', 'DRUSEN', 'CNV']\nCLASS2IDX   = {c: i for i, c in enumerate(CLASSES)}\nIDX2CLASS   = {i: c for c, i in CLASS2IDX.items()}\nNORMAL_IDX, DRUSEN_IDX, CNV_IDX = CLASS2IDX['NORMAL'], CLASS2IDX['DRUSEN'], CLASS2IDX['CNV']\nIMG_SIZE = 224\n\n# Shared training hyperparameters (exact TRIAGE-main / Codes_Compare parity)\nBATCH_SIZE_LABELED = 8\nMU                 = 2\nOPT_LR, OPT_MOM, OPT_WD, OPT_NESTEROV = 0.005, 0.9, 0.001, True\nSCHED_WARMUP_STEPS, SCHED_NUM_CYCLES  = 0, 7.0 / 16.0\nEMA_DECAY          = 0.999\nVAL_SELECT_AUC_WEIGHT = 0.7\n\n# Option B split ratios\nTRAIN_RATIO, VAL_HELDOUT_RATIO, CALIB_RATIO = 0.20, 0.15, 0.70\n\n# TRIAGE constants\nCLINICAL_RISK_MATRIX_NP = np.array([[0., 1., 1.], [2., 0., 1.], [5., 2., 0.]], dtype=np.float32)\nTHRESHOLD = 0.95\nTAU_0, ALPHA, TAU_MIN, TAU_MAX, CLASS_EMA_MOMENTUM = 0.95, 0.05, 0.90, 0.98, 0.999\nRISK_BUDGET, CRC_DELTA = 0.34, 0.10\nCRC_LAMBDA_GRID = np.linspace(0.05, 3.0, 301)\nCRC_MIN_FINE_CONF, PARTIAL_MIN_BINARY_CONF = 0.80, 0.90\nCOVERAGE_TARGET, DUAL_LR, DUAL_MU_MAX = 0.60, 0.01, 2.0\nGRAPH_LOW_DIM, GRAPH_QUEUE, GRAPH_QUEUE_WARMUP = 64, 1024, 1024\nGRAPH_ALPHA, GRAPH_T, GRAPH_CONTRAST_TH, LAMBDA_C, LAMBDA_U = 1.0, 0.2, 0.8, 0.0, 1.0\nWINDOW, VOLUME_TRANSFORMER_LAYERS, VOLUME_TRANSFORMER_HEADS, VOLUME_TRANSFORMER_DROPOUT = 5, 2, 4, 0.1\n\n# Baseline hyperparameters\nPL_THRESHOLD, PL_LAMBDA_U, PL_RAMPUP_STEPS = 0.95, 1.0, 2048\nMT_EMA_DECAY, MT_CONSISTENCY, MT_RAMPUP_STEPS = 0.999, 1.0, 4096\nFM_THRESHOLD, FM_LAMBDA_U, FM_T = 0.95, 1.0, 1.0\nFX_THRESHOLD, FX_LAMBDA_U, FX_USE_WARMUP = 0.95, 1.0, True\nFREE_EMA_M, FREE_LAMBDA_U, FREE_LAMBDA_F, FREE_USE_SAF = 0.999, 1.0, 0.05, True\nCO_LOW_DIM, CO_ALPHA, CO_T, CO_QUEUE, CO_QUEUE_WARMUP = 64, 0.9, 0.2, 1024, 1024\nCO_LAMBDA_C, CO_LAMBDA_U, CO_CONTRAST_TH, CO_THRESHOLD = 1.0, 1.0, 0.8, 0.95\n\nDEFAULT_KAGGLE_CSV = (\n    '/kaggle/input/datasets/ashrafulhossenakash/labeled-retinal-oct-dataset/'\n    'Labeled Retinal Optical Coherence Tomography Dataset for Classification '\n    'of Normal, Drusen, and CNV Cases/data_information.csv'\n)\nDEFAULT_KAGGLE_IMG = (\n    '/kaggle/input/datasets/ashrafulhossenakash/labeled-retinal-oct-dataset/'\n    'Labeled Retinal Optical Coherence Tomography Dataset for Classification '\n    'of Normal, Drusen, and CNV Cases/NEH_UT_2021RetinalOCTDataset/'\n    'NEH_UT_2021RetinalOCTDataset'\n)\nDEFAULT_LOCAL_ROOT = (\n    r'g:\\Research\\Thesis_OCT_SSL\\Datasets\\Noor Eye Hospital\\Labeled Retinal '\n    r'Optical Coherence Tomography Dataset for Classification of Normal, Drusen, and CNV Cases'\n)\nDEFAULT_LOCAL_CSV = os.path.join(DEFAULT_LOCAL_ROOT, 'data_information.csv')\nDEFAULT_LOCAL_IMG = DEFAULT_LOCAL_ROOT\n\n# ── RandAugment & Transforms ───────────────────────────────────────────────────\nPARAMETER_MAX = 10\ndef AutoContrast(img, **kw): return PIL.ImageOps.autocontrast(img)\ndef Brightness(img, v, max_v, bias=0): return PIL.ImageEnhance.Brightness(img).enhance(float(v)*max_v/PARAMETER_MAX + bias)\ndef Color(img, v, max_v, bias=0): return PIL.ImageEnhance.Color(img).enhance(float(v)*max_v/PARAMETER_MAX + bias)\ndef Contrast(img, v, max_v, bias=0): return PIL.ImageEnhance.Contrast(img).enhance(float(v)*max_v/PARAMETER_MAX + bias)\ndef Equalize(img, **kw): return PIL.ImageOps.equalize(img)\ndef Identity(img, **kw): return img\ndef Posterize(img, v, max_v, bias=0): return PIL.ImageOps.posterize(img, int(v*max_v/PARAMETER_MAX)+bias)\ndef Sharpness(img, v, max_v, bias=0): return PIL.ImageEnhance.Sharpness(img).enhance(float(v)*max_v/PARAMETER_MAX + bias)\ndef Solarize(img, v, max_v, bias=0): return PIL.ImageOps.solarize(img, 256 - (int(v*max_v/PARAMETER_MAX)+bias))\n\ndef CutoutAbs(img, v, **kw):\n    w, h = img.size\n    x0, y0 = np.random.uniform(0, w), np.random.uniform(0, h)\n    x0, y0 = int(max(0, x0 - v/2.)), int(max(0, y0 - v/2.))\n    x1, y1 = int(min(w, x0 + v)), int(min(h, y0 + v))\n    img = img.copy()\n    PIL.ImageDraw.Draw(img).rectangle((x0, y0, x1, y1), (127, 127, 127))\n    return img\n\ndef Rotate(img, v, max_v, bias=0):\n    v = int(v * max_v / PARAMETER_MAX) + bias\n    return img.rotate(-v if random.random() < 0.5 else v)\ndef ShearX(img, v, max_v, bias=0):\n    v = float(v) * max_v / PARAMETER_MAX + bias\n    return img.transform(img.size, Image.AFFINE, (1, -v if random.random()<0.5 else v, 0, 0, 1, 0))\ndef ShearY(img, v, max_v, bias=0):\n    v = float(v) * max_v / PARAMETER_MAX + bias\n    return img.transform(img.size, Image.AFFINE, (1, 0, 0, -v if random.random()<0.5 else v, 1, 0))\ndef TranslateX(img, v, max_v, bias=0):\n    v = float(v) * max_v / PARAMETER_MAX + bias\n    if random.random() < 0.5: v = -v\n    return img.transform(img.size, Image.AFFINE, (1, 0, int(v*img.size[0]), 0, 1, 0))\ndef TranslateY(img, v, max_v, bias=0):\n    v = float(v) * max_v / PARAMETER_MAX + bias\n    if random.random() < 0.5: v = -v\n    return img.transform(img.size, Image.AFFINE, (1, 0, 0, 0, 1, int(v*img.size[1])))\n\nclass RandAugmentMC:\n    def __init__(self, n=2, m=10):\n        self.n, self.m = n, m\n        self.pool = [\n            (AutoContrast, None, None), (Brightness, 0.9, 0.05), (Color, 0.9, 0.05),\n            (Contrast, 0.9, 0.05), (Equalize, None, None), (Identity, None, None),\n            (Posterize, 4, 4), (Rotate, 30, 0), (Sharpness, 0.9, 0.05),\n            (ShearX, 0.3, 0), (ShearY, 0.3, 0), (Solarize, 256, 0),\n            (TranslateX, 0.3, 0), (TranslateY, 0.3, 0),\n        ]\n    def __call__(self, img):\n        for op, max_v, bias in random.choices(self.pool, k=self.n):\n            v = np.random.randint(1, self.m)\n            if random.random() < 0.5:\n                img = op(img, v=v, max_v=max_v, bias=bias)\n        return CutoutAbs(img, 16)\n\n_NORM = T.Normalize(mean=[0.485, 0.456, 0.406], std=[0.229, 0.224, 0.225])\nweak_transform        = T.Compose([T.RandomHorizontalFlip(), T.Resize(256), T.CenterCrop(IMG_SIZE), T.ToTensor(), _NORM])\nstrong_transform      = T.Compose([T.RandomHorizontalFlip(), T.Resize(256), T.CenterCrop(IMG_SIZE), RandAugmentMC(2, 10), T.ToTensor(), _NORM])\neval_transform        = T.Compose([T.Resize(256), T.CenterCrop(IMG_SIZE), T.ToTensor(), _NORM])\nweak_transform_fast   = T.Compose([T.RandomHorizontalFlip(), T.CenterCrop(IMG_SIZE), T.ToTensor(), _NORM])\nstrong_transform_fast = T.Compose([T.RandomHorizontalFlip(), T.CenterCrop(IMG_SIZE), RandAugmentMC(2, 10), T.ToTensor(), _NORM])\neval_transform_fast   = T.Compose([T.CenterCrop(IMG_SIZE), T.ToTensor(), _NORM])\n\n_IMG_CACHE = {}   # filepath -> ((w, h), rgb_bytes) pre-resized to shorter edge 256\n\ndef preload_noor_images_to_ram(df):\n    avail_gb = psutil.virtual_memory().available / 1e9\n    if not PRELOAD_IMAGES_TO_RAM or avail_gb < 8.0:\n        print(f'RAM image cache skipped (PRELOAD={PRELOAD_IMAGES_TO_RAM}, avail={avail_gb:.1f}GB).')\n        return\n    fps = sorted(df['filepath'].unique())\n    t_s = time.time()\n    def _read_one(fp):\n        im = T.functional.resize(Image.open(fp).convert('RGB'), 256)\n        return fp, (im.size, im.tobytes())\n    with ThreadPoolExecutor(max_workers=8) as ex:\n        for fp, payload in ex.map(_read_one, fps):\n            _IMG_CACHE[fp] = payload\n    gb_used = sum(len(v[1]) for v in _IMG_CACHE.values()) / 1e9\n    print(f'RAM image cache ready: {len(_IMG_CACHE):,} images pre-resized in {time.time()-t_s:.1f}s ({gb_used:.2f} GB).')\n\ndef _get_pil(fp):\n    hit = _IMG_CACHE.get(fp)\n    if hit is not None:\n        return Image.frombytes('RGB', hit[0], hit[1]), True\n    return Image.open(fp).convert('RGB'), False\n\ndef _tf_weak(fp):\n    img, cached = _get_pil(fp)\n    return (weak_transform_fast if cached else weak_transform)(img)\n\ndef _tf_eval(fp):\n    img, cached = _get_pil(fp)\n    return (eval_transform_fast if cached else eval_transform)(img)\n\ndef _tf_views(fp, mode='weak_strong'):\n    img, cached = _get_pil(fp)\n    wt = weak_transform_fast if cached else weak_transform\n    st = strong_transform_fast if cached else strong_transform\n    if mode == 'single_weak':    return wt(img)\n    if mode == 'weak_weak':      return (wt(img), wt(img))\n    if mode == 'weak_strong':    return (wt(img), st(img))\n    if mode == 'weak_strong2':   return (wt(img), st(img), st(img))\n    raise ValueError(mode)\n\ndef _resolve_csv_path(path):\n    if os.path.isfile(path): return path\n    if os.path.isdir(path):\n        tgt = os.path.basename(path)\n        for root, _, files in os.walk(path):\n            if tgt in files: return os.path.join(root, tgt)\n    raise FileNotFoundError(f'Missing CSV at {path}')\n\n_DIR_CACHE = {}\ndef _resolve_path(p):\n    if os.path.exists(p): return p\n    d, name = os.path.dirname(p), os.path.basename(p)\n    lut = _DIR_CACHE.get(d)\n    if lut is None:\n        lut = {n.lower(): n for n in os.listdir(d)} if os.path.isdir(d) else {}\n        _DIR_CACHE[d] = lut\n    hit = lut.get(name.lower())\n    return os.path.join(d, hit) if hit else None\n\ndef load_noor_dataframe(local_mode=LOCAL_MODE):\n    csv_path = _resolve_csv_path(DEFAULT_LOCAL_CSV if local_mode else DEFAULT_KAGGLE_CSV)\n    img_root = DEFAULT_LOCAL_IMG if local_mode else DEFAULT_KAGGLE_IMG\n    raw = pd.read_csv(csv_path)\n    raw['label']     = raw['Label'].str.upper()\n    raw['filepath']  = raw['Directory'].apply(lambda d: os.path.join(img_root, d))\n    raw['patient']   = raw['Patient ID'].astype(str)\n    raw['volume_id'] = raw['Patient ID'].astype(str) + '_' + raw['Eye'].astype(str) + '_' + raw['Class'].astype(str)\n    raw['bscan']     = raw['B-scan'].astype(int)\n    df = raw[['filepath', 'label', 'patient', 'volume_id', 'bscan']].reset_index(drop=True)\n    df['filepath'] = df['filepath'].map(_resolve_path)\n    df = df[df['filepath'].notna()].reset_index(drop=True)\n    assert df['volume_id'].nunique() == 554\n    return df\n\ndef build_patient_splits(df, train_ratio=TRAIN_RATIO, split_seed=SPLIT_SEED):\n    tv_idx, test_idx = next(GroupShuffleSplit(1, test_size=0.20, random_state=split_seed).split(df, groups=df['patient']))\n    train_val_df, test_df = df.iloc[tv_idx].reset_index(drop=True), df.iloc[test_idx].reset_index(drop=True)\n\n    tr_idx, held_idx = next(GroupShuffleSplit(1, test_size=VAL_HELDOUT_RATIO, random_state=split_seed).split(train_val_df, groups=train_val_df['patient']))\n    train_pool_df, heldout_df = train_val_df.iloc[tr_idx].reset_index(drop=True), train_val_df.iloc[held_idx].reset_index(drop=True)\n\n    val_idx, calib_idx = next(GroupShuffleSplit(1, test_size=CALIB_RATIO, random_state=split_seed).split(heldout_df, groups=heldout_df['patient']))\n    val_df, calib_df = heldout_df.iloc[val_idx].reset_index(drop=True), heldout_df.iloc[calib_idx].reset_index(drop=True)\n\n    lab_idx, unlab_idx = next(GroupShuffleSplit(1, train_size=train_ratio, random_state=split_seed).split(train_pool_df, groups=train_pool_df['patient']))\n    labeled_df, unlabeled_df = train_pool_df.iloc[lab_idx].reset_index(drop=True), train_pool_df.iloc[unlab_idx].reset_index(drop=True)\n\n    splits = {'labeled': labeled_df, 'unlabeled': unlabeled_df, 'val': val_df, 'calib': calib_df, 'test': test_df}\n    keys = list(splits.keys())\n    for i in range(len(keys)):\n        for j in range(i + 1, len(keys)):\n            ov = set(splits[keys[i]]['patient']) & set(splits[keys[j]]['patient'])\n            assert not ov, f'Patient leak {keys[i]} vs {keys[j]}: {ov}'\n    return splits\n\nclass LabeledOCTDataset(Dataset):\n    def __init__(self, df, is_weak=True):\n        self.fps = df['filepath'].tolist(); self.ys = [CLASS2IDX[l] for l in df['label'].tolist()]; self.is_weak = is_weak\n    def __len__(self): return len(self.fps)\n    def __getitem__(self, i): return (_tf_weak(self.fps[i]) if self.is_weak else _tf_eval(self.fps[i])), self.ys[i]\n\nclass EvalOCTDataset(Dataset):\n    def __init__(self, df):\n        self.fps = df['filepath'].tolist(); self.ys = [CLASS2IDX[l] for l in df['label'].tolist()]\n    def __len__(self): return len(self.fps)\n    def __getitem__(self, i): return _tf_eval(self.fps[i]), self.ys[i]\n\nclass UnlabeledFlatDataset(Dataset):\n    def __init__(self, df, mode='weak_strong', return_index=False):\n        self.fps = df['filepath'].tolist(); self.ys = [CLASS2IDX[l] for l in df['label'].tolist()]\n        self.mode, self.return_index = mode, return_index\n    def __len__(self): return len(self.fps)\n    def __getitem__(self, i):\n        views = _tf_views(self.fps[i], self.mode)\n        return (views, self.ys[i], i) if self.return_index else (views, self.ys[i])\n\nclass VolumeSequenceDataset(Dataset):\n    def __init__(self, df, window=WINDOW, use_graph_smoothing=False):\n        self.vol_index = {vid: sub.sort_values('bscan').reset_index(drop=True) for vid, sub in df.groupby('volume_id')}\n        self.window, self.use_graph = window, use_graph_smoothing\n        self._bpos = {}\n        for vid, sub in self.vol_index.items():\n            for pos, fp in enumerate(sub['filepath'].tolist()):\n                self._bpos[fp] = (vid, pos)\n        self.fps = df['filepath'].tolist(); self.ys = [CLASS2IDX[l] for l in df['label'].tolist()]\n    def __len__(self): return len(self.fps)\n    def __getitem__(self, i):\n        fp = self.fps[i]\n        if self.use_graph:\n            weak, s1, s2 = _tf_views(fp, 'weak_strong2')\n        else:\n            weak, s1 = _tf_views(fp, 'weak_strong')\n            s2 = s1\n        vid, pos = self._bpos[fp]; sub = self.vol_index[vid]; n = len(sub); half = self.window // 2\n        nbs, pad = [], []\n        for off in range(-half, half + 1):\n            p = pos + off\n            if 0 <= p < n:\n                nbs.append(_tf_weak(sub['filepath'].iloc[p])); pad.append(False)\n            else:\n                nbs.append(torch.zeros(3, IMG_SIZE, IMG_SIZE)); pad.append(True)\n        return (weak, s1, s2, torch.stack(nbs, 0), torch.tensor(pad, dtype=torch.bool)), self.ys[i]\n\ndef _seed_worker(wid):\n    ws = torch.initial_seed() % (2**32)\n    np.random.seed(ws); random.seed(ws)\n\nif not STATS_ONLY_MODE:\n    NOOR_DF = load_noor_dataframe(LOCAL_MODE)\n    preload_noor_images_to_ram(NOOR_DF)\n    SPLITS  = build_patient_splits(NOOR_DF, TRAIN_RATIO, SPLIT_SEED)\n    print(f'Locked Option B Split (SPLIT_SEED={SPLIT_SEED}, DEVICE={DEVICE}, AMP={USE_CUDA_AMP}, WORKERS={NUM_WORKERS}):')\n    for _k in ['labeled', 'unlabeled', 'val', 'calib', 'test']:\n        _d = SPLITS[_k]\n        print(f'  {_k:10s}: {len(_d):>5,} scans | {_d[\"patient\"].nunique():>3} pts | {_d[\"volume_id\"].nunique():>3} vols')\nelse:\n    print('STATS_ONLY_MODE=True — skipping image loading and training.')","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-11-25T15:28:35.29939Z","iopub.execute_input":"2026-11-25T15:28:35.29999Z","iopub.status.idle":"2026-11-25T15:32:31.762082Z","shell.execute_reply.started":"2026-11-25T15:28:35.299963Z","shell.execute_reply":"2026-11-25T15:32:31.761075Z"}},"outputs":[{"name":"stdout","text":"RAM image cache ready: 16,803 images pre-resized in 190.9s (5.11 GB).\nLocked Option B Split (SPLIT_SEED=12, DEVICE=cuda:0, AMP=True, WORKERS=4):\n  labeled   : 2,329 scans |  21 pts |  78 vols\n  unlabeled : 9,012 scans |  87 pts | 296 vols\n  val       :   563 scans |   6 pts |  19 vols\n  calib     : 1,406 scans |  14 pts |  45 vols\n  test      : 3,512 scans |  33 pts | 116 vols\n","output_type":"stream"}],"execution_count":2},{"id":"ddec7922","cell_type":"markdown","source":"## Cell 3 — Models, Conformal Gate, Dual-Teacher Gate, & Controllers","metadata":{}},{"id":"3df2307b","cell_type":"code","source":"class Normalize(nn.Module):\n    def __init__(self, power=2): super().__init__(); self.power = power\n    def forward(self, x): return x.div(x.pow(self.power).sum(1, keepdim=True).pow(1.0 / self.power))\n\nclass HierEffNetWithProj(nn.Module):\n    def __init__(self, low_dim=64, pretrained=True, dropout=0.2):\n        super().__init__()\n        w = tvm.EfficientNet_B0_Weights.IMAGENET1K_V1 if pretrained else None\n        self.backbone = tvm.efficientnet_b0(weights=w)\n        fd = self.backbone.classifier[1].in_features\n        self.backbone.classifier = nn.Identity()\n        self.drop, self.fc_binary, self.fc_fine = nn.Dropout(dropout), nn.Linear(fd, 2), nn.Linear(fd, 2)\n        self.feat_dim, self.low_dim, self.l2norm = fd, low_dim, Normalize(2)\n        self.fc1, self.bn1, self.relu_mlp, self.fc2 = nn.Linear(fd, fd), nn.BatchNorm1d(fd), nn.ReLU(True), nn.Linear(fd, low_dim)\n    def backbone_features(self, x): return self.backbone(x)\n    def forward(self, x):\n        f = self.backbone_features(x)\n        return self.fc_binary(self.drop(f)), self.fc_fine(self.drop(f)), self.l2norm(self.fc2(self.relu_mlp(self.bn1(self.fc1(f)))))\n\nclass VolumeContextEncoder(nn.Module):\n    def __init__(self, feat_dim, window=WINDOW, n_layers=VOLUME_TRANSFORMER_LAYERS, n_heads=VOLUME_TRANSFORMER_HEADS, dropout=VOLUME_TRANSFORMER_DROPOUT):\n        super().__init__()\n        self.window, self.center, self.pad_idx = window, window // 2, window\n        self.pos_embed = nn.Embedding(window + 1, feat_dim)\n        enc = nn.TransformerEncoderLayer(d_model=feat_dim, nhead=n_heads, dim_feedforward=feat_dim*2, dropout=dropout, activation='gelu', batch_first=True, norm_first=True)\n        self.encoder = nn.TransformerEncoder(enc, num_layers=n_layers)\n        self.fc_binary, self.fc_fine = nn.Linear(feat_dim, 2), nn.Linear(feat_dim, 2)\n    def forward(self, wf, pad_mask):\n        B, W, _ = wf.shape\n        rel = torch.where(pad_mask, torch.full((B, W), self.pad_idx, device=wf.device), torch.arange(W, device=wf.device).unsqueeze(0).expand(B, W))\n        safe = pad_mask.clone(); safe[pad_mask.all(dim=1)] = False\n        ctx = self.encoder(wf + self.pos_embed(rel), src_key_padding_mask=safe)[:, self.center, :]\n        return self.fc_binary(ctx), self.fc_fine(ctx), ctx\n\nclass FlatEffNet(nn.Module):\n    def __init__(self, num_classes=NUM_CLASSES, pretrained=True, dropout=0.2):\n        super().__init__()\n        w = tvm.EfficientNet_B0_Weights.IMAGENET1K_V1 if pretrained else None\n        self.backbone = tvm.efficientnet_b0(weights=w)\n        fd = self.backbone.classifier[1].in_features; self.backbone.classifier = nn.Identity()\n        self.drop, self.fc, self.feat_dim = nn.Dropout(dropout), nn.Linear(fd, num_classes), fd\n    def forward(self, x): f = self.backbone(x); return self.fc(self.drop(f)), f\n\nclass FlatEffNetWithProj(nn.Module):\n    def __init__(self, num_classes=NUM_CLASSES, low_dim=CO_LOW_DIM, pretrained=True, dropout=0.2):\n        super().__init__()\n        w = tvm.EfficientNet_B0_Weights.IMAGENET1K_V1 if pretrained else None\n        self.backbone = tvm.efficientnet_b0(weights=w)\n        fd = self.backbone.classifier[1].in_features; self.backbone.classifier = nn.Identity()\n        self.drop, self.fc, self.feat_dim, self.low_dim, self.l2norm = nn.Dropout(dropout), nn.Linear(fd, num_classes), fd, low_dim, Normalize(2)\n        self.fc1, self.bn1, self.relu_mlp, self.fc2 = nn.Linear(fd, fd), nn.BatchNorm1d(fd), nn.ReLU(True), nn.Linear(fd, low_dim)\n    def forward(self, x):\n        f = self.backbone(x)\n        return self.fc(self.drop(f)), self.l2norm(self.fc2(self.relu_mlp(self.bn1(self.fc1(f)))))\n\nclass ModelEMA:\n    def __init__(self, device, model, decay=EMA_DECAY):\n        self.ema = deepcopy(model).to(device); self.ema.eval(); self.decay = decay\n        self.pkeys = [k for k, _ in self.ema.named_parameters()]; self.bkeys = [k for k, _ in self.ema.named_buffers()]\n        for p in self.ema.parameters(): p.requires_grad_(False)\n    def update(self, model):\n        with torch.no_grad():\n            msd, esd = model.state_dict(), self.ema.state_dict()\n            for k in self.pkeys: esd[k].copy_(esd[k]*self.decay + (1.0 - self.decay)*msd[k].detach())\n            for k in self.bkeys: esd[k].copy_(msd[k])\n\ndef hier_to_flat_probs(lb, lf):\n    pb, pf = F.softmax(lb, -1), F.softmax(lf, -1)\n    return torch.stack([pb[:, 0], pb[:, 1]*pf[:, 0], pb[:, 1]*pf[:, 1]], dim=1), pb, pf\n\n@torch.no_grad()\ndef risk_sensitive_volume_pool(scan_probs, scan_risk_cost):\n    w = 1.0 / scan_risk_cost.clamp_min(1e-3); w = w / w.sum()\n    return F.softmax((scan_probs.clamp_min(1e-8).log() * w.unsqueeze(1)).sum(dim=0), dim=0)\n\n@torch.no_grad()\ndef conformal_risk_control_search(model_, vol_mod_, calib_loader_, calib_df_, device=DEVICE):\n    was_tr = model_.training; model_.eval()\n    if vol_mod_ is not None: vol_mod_.eval()\n    ap, at = [], []\n    for xb, yb in calib_loader_:\n        with torch.amp.autocast('cuda', enabled=USE_CUDA_AMP):\n            lb, lf, _ = model_(xb.to(device, non_blocking=True))\n        pr, _, _ = hier_to_flat_probs(lb.float(), lf.float())\n        ap.append(pr.cpu()); at.append(yb)\n    if was_tr:\n        model_.train()\n        if vol_mod_ is not None: vol_mod_.train()\n    probs_cpu, true_cpu = torch.cat(ap, 0), torch.cat(at, 0)\n    rm_cpu = torch.tensor(CLINICAL_RISK_MATRIX_NP, dtype=torch.float32)\n    rpc = probs_cpu @ rm_cpu; adc = rpc.argmin(1); mr = rpc.min(1).values\n    ug  = (true_cpu != NORMAL_IDX) & (adc == NORMAL_IDX)\n    pts = calib_df_['patient'].tolist(); pids = sorted(set(pts)); n_p = len(pids)\n    ppos = {p: [] for p in pids}\n    for i, p in enumerate(pts): ppos[p].append(i)\n    hoeff = math.sqrt(math.log(1.0 / CRC_DELTA) / (2.0 * n_p))\n    best_lam = float(CRC_LAMBDA_GRID[0])\n    for lam in CRC_LAMBDA_GRID:\n        limg = (ug & (mr <= lam)).float()\n        pm = torch.tensor([limg[ppos[p]].mean().item() if ppos[p] else 0.0 for p in pids])\n        vh = float(pm.var(unbiased=True).item()) if n_p > 1 else 0.0\n        bern = math.sqrt(2.0*max(vh, 0.0)*math.log(2.0/CRC_DELTA)/n_p) + 3.0*math.log(2.0/CRC_DELTA)/max(n_p-1, 1)\n        if pm.mean().item() + min(hoeff, bern) <= RISK_BUDGET: best_lam = float(lam)\n        else: break\n    return best_lam\n\ndef hierarchical_admission_rule(lb, lf, lambda_hat, mu=0.0, probs_override=None):\n    if probs_override is None:\n        probs, pb, pf = hier_to_flat_probs(lb, lf)\n    else:\n        probs = probs_override\n        pabn = probs[:, DRUSEN_IDX] + probs[:, CNV_IDX]\n        pb = torch.stack([probs[:, NORMAL_IDX], pabn], 1)\n        pf = torch.stack([probs[:, DRUSEN_IDX], probs[:, CNV_IDX]], 1) / pabn.clamp_min(1e-12).unsqueeze(1)\n    rm = torch.tensor(CLINICAL_RISK_MATRIX_NP, device=probs.device)\n    mr, adc = (probs @ rm).min(dim=1)\n    eff_lam = lambda_hat * (1.0 + mu)\n    norm_ok = (adc == NORMAL_IDX) & (mr <= eff_lam)\n    abn_ok  = (adc != NORMAL_IDX) & (mr <= eff_lam)\n    fc, fa  = pf.max(dim=1)\n    f_res   = abn_ok & (fc >= CRC_MIN_FINE_CONF)\n    fa_cost = 0.5 * (rm[NORMAL_IDX, DRUSEN_IDX] + rm[NORMAL_IDX, CNV_IDX])\n    c_ok    = ((probs[:, NORMAL_IDX] * fa_cost) <= eff_lam) & (pb[:, 1] >= PARTIAL_MIN_BINARY_CONF)\n    f_part  = c_ok & (fc < CRC_MIN_FINE_CONF) & (~f_res)\n    admit   = (norm_ok | f_res | f_part).float()\n    f_cls   = torch.where(fa == 0, torch.full_like(adc, DRUSEN_IDX), torch.full_like(adc, CNV_IDX))\n    ht      = torch.where(f_res, f_cls, torch.full_like(adc, NORMAL_IDX))\n    return admit, f_part, ht\n\n@torch.no_grad()\ndef dual_teacher_agreement(slb, slf, vlb, vlf):\n    sb, vb = slb.argmax(-1), vlb.argmax(-1)\n    return (sb == vb) & (~((sb == 1) & (vb == 1)) | (slf.argmax(-1) == vlf.argmax(-1)))\n\nclass PrimalDualController:\n    def __init__(self): self.mu = 0.0\n    def step(self, cov): self.mu = float(np.clip(self.mu + DUAL_LR*(COVERAGE_TARGET - cov), 0.0, DUAL_MU_MAX)); return self.mu\n\nclass CAPTEmaTracker:\n    def __init__(self, device=DEVICE): self.counts = torch.ones(NUM_CLASSES, device=device) / NUM_CLASSES\n    @torch.no_grad()\n    def update(self, pt, mp):\n        c = mp.ge(TAU_MIN)\n        if c.sum() == 0: return\n        bc = torch.tensor([(pt[c] == k).float().sum() for k in range(NUM_CLASSES)], device=self.counts.device)\n        self.counts = CLASS_EMA_MOMENTUM*self.counts + (1.0 - CLASS_EMA_MOMENTUM)*(bc / bc.sum().clamp(1e-12))\n    def thresholds(self):\n        return (TAU_0 + ALPHA*torch.log(self.counts.clamp(1e-12) / (1.0/NUM_CLASSES))).clamp(TAU_MIN, TAU_MAX)\n\nclass MemoryBank:\n    def __init__(self, size=1024, dim=64, device=DEVICE):\n        self.size, self.ptr, self.filled = size, 0, 0\n        self.embeds = torch.zeros(size, dim, device=device); self.probs = torch.zeros(size, NUM_CLASSES, device=device)\n    @torch.no_grad()\n    def enqueue(self, e, p):\n        idx = (torch.arange(e.size(0), device=e.device) + self.ptr) % self.size\n        self.embeds[idx], self.probs[idx] = e.detach(), p.detach()\n        self.ptr = int((self.ptr + e.size(0)) % self.size); self.filled = min(self.filled + e.size(0), self.size)\n    def is_ready(self): return self.filled >= self.size\n    def view(self): return self.embeds[:self.filled], self.probs[:self.filled]\n\nclass SelfAdaptiveThreshold:\n    def __init__(self, device=DEVICE):\n        self.tau_global = torch.tensor(1.0 / NUM_CLASSES, device=device)\n        self.p_model = torch.ones(NUM_CLASSES, device=device) / NUM_CLASSES\n        self.h_model = torch.ones(NUM_CLASSES, device=device) / NUM_CLASSES\n    @torch.no_grad()\n    def update(self, pw):\n        mp, pl = pw.max(1)\n        self.tau_global = FREE_EMA_M*self.tau_global + (1.0 - FREE_EMA_M)*mp.mean()\n        self.p_model    = FREE_EMA_M*self.p_model    + (1.0 - FREE_EMA_M)*pw.mean(0)\n        h = torch.bincount(pl, minlength=NUM_CLASSES).float()\n        self.h_model    = FREE_EMA_M*self.h_model    + (1.0 - FREE_EMA_M)*(h / h.sum().clamp(1.0))\n    def thresholds(self): return (self.p_model / self.p_model.max().clamp(1e-12)) * self.tau_global\n\nclass FlexMatchCPL:\n    def __init__(self, n_u): self.n_u = n_u; self.sel = torch.full((n_u,), -1, dtype=torch.long)\n    def thresholds(self, device=DEVICE):\n        sig = torch.tensor([float((self.sel == c).sum()) for c in range(NUM_CLASSES)])\n        den = max(float(sig.max()), float(self.n_u - sig.sum())) if FX_USE_WARMUP else float(sig.max())\n        beta = sig / max(den, 1.0)\n        return ((beta / (2.0 - beta)) * FX_THRESHOLD).to(device)\n    def update(self, idx, pl, adm):\n        i, p, a = idx.cpu(), pl.cpu(), adm.cpu().bool()\n        self.sel[i[a]] = p[a]; self.sel[i[~a]] = -1\n\nprint('Core modules ready.')","metadata":{"trus