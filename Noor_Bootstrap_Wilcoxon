non_blocking=True), pm.to(dev, non_blocking=True)\n    B_u = uw.shape[0]\n    use_graph = bool(spec['use_graph'])\n    con_on = bool(use_graph and bank is not None and bank.is_ready() and step > GRAPH_QUEUE_WARMUP)\n\n    with torch.amp.autocast('cuda', enabled=USE_CUDA_AMP):\n        lbx, lfx, _ = model_(ix)\n        if use_graph:\n            us2 = us2.to(dev, non_blocking=True)\n            lbu, lfu, pfu = model_(torch.cat([uw, us, us2], 0))\n            lbw, lbs1, lbs2 = lbu.chunk(3); lfw, lfs1, lfs2 = lfu.chunk(3); pfw, pfs1, pfs2 = pfu.chunk(3)\n        else:\n            lbu, lfu, pfu = model_(torch.cat([uw, us], 0))\n            lbw, lbs1 = lbu.chunk(2); lfw, lfs1 = lfu.chunk(2); pfw, pfs1 = pfu.chunk(2)\n            lbs2 = lfs2 = pfs2 = None\n\n        if spec['use_vol']:\n            with torch.no_grad():\n                fw = model_.backbone_features(ws.view(B_u*ws.shape[1], 3, IMG_SIZE, IMG_SIZE)).view(B_u, ws.shape[1], -1)\n            vlbw, vlfw, _ = vol_(fw, pm)\n        else:\n            vlbw = vlfw = None\n\n    # Compute losses & probabilities in FP32 for exact numerical stability\n    lbx, lfx = lbx.float(), lfx.float()\n    lbw, lbs1, lfw, lfs1 = lbw.float(), lbs1.float(), lfw.float(), lfs1.float()\n    if lbs2 is not None: lbs2, lfs2 = lbs2.float(), lfs2.float()\n    abn_x = (tx != NORMAL_IDX)\n    Lx = F.cross_entropy(lbx, abn_x.long()) + (F.cross_entropy(lfx[abn_x], (tx[abn_x] == CNV_IDX).long()) if abn_x.any() else lfx.sum()*0.0)\n\n    if spec['use_vol']:\n        agree = dual_teacher_agreement(lbw.detach(), lfw.detach(), vlbw.float().detach(), vlfw.float().detach())\n    else:\n        agree = torch.ones(B_u, dtype=torch.bool, device=dev)\n\n    with torch.no_grad():\n        qr, _, _ = hier_to_flat_probs(lbw.detach(), lfw.detach())\n        if con_on:\n            be, bp = bank.view()\n            qs = GRAPH_ALPHA*qr + (1.0 - GRAPH_ALPHA)*(torch.softmax(pfw.float().detach() @ be.t() / GRAPH_T, 1) @ bp)\n            qs = qs / qs.sum(1, keepdim=True).clamp(min=1e-12)\n        else:\n            qs = qr\n\n    mp, pt = qs.max(-1)\n    if spec['use_capt']:\n        capt.update(pt, mp); tau_c = capt.thresholds()\n    else:\n        tau_c = torch.full((NUM_CLASSES,), THRESHOLD, device=dev)\n\n    if spec['use_hc']:\n        admit, is_part, _ = hierarchical_admission_rule(lbw.detach(), lfw.detach(), lam, mu=dual.mu, probs_override=qs if con_on else None)\n    else:\n        admit = mp.ge(tau_c[pt]).float(); is_part = torch.zeros(B_u, dtype=torch.bool, device=dev)\n\n    cmask = torch.where(is_part, torch.ones_like(mp), mp.ge(tau_c[pt]).float())\n    fmask = admit * agree.float() * cmask\n    full_m, part_m = fmask * (~is_part).float(), fmask * is_part.float()\n\n    def _hsce(_lb, _lf):\n        lpb, lpf = F.log_softmax(_lb, 1), F.log_softmax(_lf, 1)\n        return -(qs[:, NORMAL_IDX]*lpb[:, 0] + (qs[:, DRUSEN_IDX]+qs[:, CNV_IDX])*lpb[:, 1]), -(qs[:, DRUSEN_IDX]*lpf[:, 0] + qs[:, CNV_IDX]*lpf[:, 1])\n    b1, f1 = _hsce(lbs1, lfs1)\n    if lbs2 is not None:\n        b2, f2 = _hsce(lbs2, lfs2); ce_b, ce_f = 0.5*(b1+b2), 0.5*(f1+f2)\n    else:\n        ce_b, ce_f = b1, f1\n    Lu = (ce_b * full_m).mean() + (ce_f * full_m).mean()\n\n    def _pnll(_lb, _lf):\n        ps, _, _ = hier_to_flat_probs(_lb, _lf)\n        return -torch.log((ps[:, DRUSEN_IDX] + ps[:, CNV_IDX]).clamp_min(1e-8))\n    pn = _pnll(lbs1, lfs1)\n    if lbs2 is not None: pn = 0.5*(pn + _pnll(lbs2, lfs2))\n    Lu = Lu + (pn * part_m).mean()\n\n    if use_graph and bank is not None: bank.enqueue(pfw.float(), qs)\n    return {'loss': Lx + LAMBDA_U*Lu, 'mask_prob': fmask.mean()}\n\n@torch.no_grad()\ndef _eval_loader(model, arch, loader, dev=DEVICE):\n    model.eval(); probs_l, true_l = [], []\n    for xb, yb in loader:\n        xb = xb.to(dev, non_blocking=True)\n        with torch.amp.autocast('cuda', enabled=USE_CUDA_AMP):\n            if arch == 'hier':\n                lb, lf, _ = model(xb); pr, _, _ = hier_to_flat_probs(lb.float(), lf.float(