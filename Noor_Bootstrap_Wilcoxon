=0.7478 VlAUC=0.8817 lam=0.050\n<<< DONE meanteacher_b20_seed12 in 18.9m | ScanAcc=77.31%\n\n>>> TRAINING pseudolabel_b20_seed12 (steps=10240, split_seed=12, model_seed=12, amp=True)\n","output_type":"stream"},{"output_type":"display_data","data":{"text/plain":"pseudolabel_b20_seed12:   0%|          | 0/10240 [00:00<?, ?it/s]","application/vnd.jupyter.widget-view+json":{"version_major":2,"version_minor":0,"model_id":"ae4562a59d9249d6983812deb10b4cdd"}},"metadata":{}},{"name":"stdout","text":"  [pseudolabel_b20_seed12] step 1024/10240 | VlAcc=0.7176 VlAUC=0.8025 lam=0.050\n  [pseudolabel_b20_seed12] step 2048/10240 | VlAcc=0.8579 VlAUC=0.9484 lam=0.050\n  [pseudolabel_b20_seed12] step 3072/10240 | VlAcc=0.7531 VlAUC=0.9386 lam=0.050\n  [pseudolabel_b20_seed12] step 4096/10240 | VlAcc=0.8437 VlAUC=0.9302 lam=0.050\n  [pseudolabel_b20_seed12] step 5120/10240 | VlAcc=0.8082 VlAUC=0.9447 lam=0.050\n  [pseudolabel_b20_seed12] step 6144/10240 | VlAcc=0.4476 VlAUC=0.8917 lam=0.050\n  [pseudolabel_b20_seed12] step 7168/10240 | VlAcc=0.8099 VlAUC=0.9287 lam=0.050\n  [pseudolabel_b20_seed12] step 8192/10240 | VlAcc=0.8508 VlAUC=0.9456 lam=0.050\n  [pseudolabel_b20_seed12] step 9216/10240 | VlAcc=0.8774 VlAUC=0.9615 lam=0.050\n  [pseudolabel_b20_seed12] step 10240/10240 | VlAcc=0.8721 VlAUC=0.9606 lam=0.050\n<<< DONE pseudolabel_b20_seed12 in 15.6m | ScanAcc=87.73%\n\n>>> TRAINING sup_only_b20_seed12 (steps=10240, split_seed=12, model_seed=12, amp=True)\n","output_type":"stream"},{"output_type":"display_data","data":{"text/plain":"sup_only_b20_seed12:   0%|          | 0/10240 [00:00<?, ?it/s]","application/vnd.jupyter.widget-view+json":{"version_major":2,"version_minor":0,"model_id":"d9b1e02abb6446a0bbd0e913f0c55905"}},"metadata":{}},{"name":"stdout","text":"  [sup_only_b20_seed12] step 1024/10240 | VlAcc=0.5755 VlAUC=0.8431 lam=0.050\n  [sup_only_b20_seed12] step 2048/10240 | VlAcc=0.7300 VlAUC=0.8563 lam=0.050\n  [sup_only_b20_seed12] step 3072/10240 | VlAcc=0.5382 VlAUC=0.5683 lam=0.050\n  [sup_only_b20_seed12] step 4096/10240 | VlAcc=0.6607 VlAUC=0.8321 lam=0.050\n  [sup_only_b20_seed12] step 5120/10240 | VlAcc=0.6927 VlAUC=0.8612 lam=0.050\n  [sup_only_b20_seed12] step 6144/10240 | VlAcc=0.7904 VlAUC=0.9317 lam=0.050\n  [sup_only_b20_seed12] step 7168/10240 | VlAcc=0.8739 VlAUC=0.9631 lam=0.050\n  [sup_only_b20_seed12] step 8192/10240 | VlAcc=0.8952 VlAUC=0.9665 lam=0.050\n  [sup_only_b20_seed12] step 9216/10240 | VlAcc=0.8881 VlAUC=0.9641 lam=0.050\n  [sup_only_b20_seed12] step 10240/10240 | VlAcc=0.8899 VlAUC=0.9681 lam=0.050\n<<< DONE sup_only_b20_seed12 in 14.7m | ScanAcc=85.82%\n","output_type":"stream"}],"execution_count":4},{"id":"74e53aa9","cell_type":"markdown","source":"## Cell 5 — Complete M2 Statistical Suite (Bootstrap 95% CIs, Patient-Level Wilcoxon + $N_{\\text{eff}}$ + Holm–Bonferroni, Seed-wise Table, & All-Pairs Matrix)\n\nAutomatically merges ALL exported seed files (`preds_*_b*_seed*.csv` and `vol_preds_*_b*_seed*.csv`) across `OUTPUT_DIR` and `PREVIOUS_SEED_DIRS`:\n- After Run 1 (`12`): reports single-seed patient-level CIs & Wilcoxon tests.\n- After Run 3 (`12, 111, 165` combined): outputs the **final 3-seed M2 tables** (`m2_summary_triage_vs_baselines.csv`, `m2_all_pairwise_holm_matrix.csv`, `m2_Supplementary_Table_S1.tex`, and `m2_seedwise_table.tex`).","metadata":{}},{"id":"19d6b595","cell_type":"code","source":"METHOD_DISPLAY = {\n    'sup_only':            'Supervised (20\\\\%)',\n    'pseudolabel':         'Pseudo-Label',\n    'meanteacher':         'Mean Teacher',\n    'fixmatch':            'FixMatch',\n    'freematch':           'FreeMatch',\n    'comatch':             'CoMatch',\n    'flexmatch':           'FlexMatch',\n    'ablation_fixed_full': 'Fixed Threshold ($\\\\tau=0.95$, Full Arch)',\n    'triage':              'TRIAGE (Ours)',\n    'sup_100':             'Supervised (100\\\\% Oracle)',\n}\n\ndef discover_m2_runs(output_dir=OUTPUT_DIR, extra_dirs=None):\n    found = defaultdict(dict)\n    dirs = [output_dir] + (list(PREVIOUS_SEED_DIRS) if extra_dirs is None else list(extra_dirs))\n    for d in dirs:\n        if not d or not os.path.isdir(d): continue\n        for pcsv in sorted(glob.glob(os.path.join(d, '**', 'preds_*_b*_seed*.csv'), recursive=True)):\n            base = os.path.basename(pcsv).replace('preds_', '').replace('.csv', '')\n            mp, sp = base.rsplit('_seed', 1); method, _ = mp.rsplit('_b', 1); seed = int(sp)\n            if seed in found[method]: continue\n            vcsv = os.path.join(os.path.dirname(pcsv), f'vol_preds_{base}.csv')\n            if os.path.isfile(vcsv): found[method][seed] = (pcsv, vcsv)\n    return found\n\ndef holm_bonferroni(pvals):\n    m = len(pvals)\n    if m == 0: return []\n    order = np.argsort(pvals); adj = np.zeros(m); prev = 0.0\n    for r, idx in enumerate(order):\n        val = max(prev, min(1.0, (m - r) * float(pvals[idx])))\n        adj[idx] = prev = val\n    return adj.tolist()\n\ndef _pool_metrics(df, is_vol=False, mode='rs'):\n    yt = df['vol_true' if is_vol else 'y_true'].to_numpy()\n    yp = df[f'vol_pred_{mode}' if is_vol else 'y_pred'].to_numpy()\n    cols = [f'p_normal_{mode}', f'p_drusen_{mode}', f'p_cnv_{mode}'] if is_vol else ['p_normal', 'p_drusen', 'p_cnv']\n    pr = df[cols].to_numpy()\n    acc = float((yt == yp).mean())\n    f1  = float(f1_score(yt, yp, labels=[0, 1, 2], average='macro', zero_division=0))\n    ohe = np.zeros((len(yt), 3)); ohe[np.arange(len(yt)), yt] = 1\n    try: auc_v = float(roc_auc_score(ohe, pr, average='macro', multi_class='ovr'))\n    except ValueError: auc_v = float('nan')\n    dis = (yt != NORMAL_IDX)\n    ugr = float((yp[dis] == NORMAL_IDX).mean()) if dis.any() else float('nan')\n    return acc, f1, auc_v, ugr\n\ndef run_m2_statistics(output_dir=OUTPUT_DIR, extra_dirs=None, B=BOOTSTRAP_B, boot_seed=BOOTSTRAP_SEED):\n    found = discover_m2_runs(output_dir, extra_dirs)\n    if not found:\n        print('No exported CSVs found yet.')\n        return None\n    mode = 'rs' if VOL_POOL_PRIMARY == 'risk_sensitive' else 'mean'\n\n    # Preload per-method, per-seed scan/vol frames & patient metrics\n    loaded, seed_rows = {}, []\n    for m, smap in sorted(found.items()):\n        loaded[m] = {}\n        for s, (pcsv, vcsv) in sorted(smap.items()):\n            ds, dv = pd.read_csv(pcsv), pd.read_csv(vcsv)\n            sa, sf, sauc, su = _pool_metrics(ds, is_vol=False)\n            va, vf, vauc, vu = _pool_metrics(dv, is_vol=True, mode=mode)\n            seed_rows.append({'method': m, 'seed': s, 'scan_acc_pct': sa*100, 'scan_f1': sf, 'scan_auc_pct': sauc*100,\n                              'scan_ugr_pct': su*100, 'vol_acc_pct': va*100, 'vol_f1': vf, 'vol_auc_pct': vauc*100, 'vol_ugr_pct': vu*100})\n            pt = {}\n            for p, g in ds.groupby('patient'):\n                yt, yp = g['y_true'].to_numpy(), g['y_pred'].to_numpy(); dis = (yt != NORMAL_IDX)\n                pt[str(p)] = {'acc': float((yt==yp).mean()), 'ugr': float((yp[dis]==NORMAL_IDX).mean()) if dis.any() else float('nan')}\n            for p, g in dv.groupby('patient'):\n                vt, vp = g['vol_true'].to_numpy(), g[f'vol_pred_{mode}'].to_numpy(); vdis = (vt != NORMAL_IDX)\n                pt[str(p)]['vol_acc'] = float((vt==vp).mean())\n                pt[str(p)]['vol_ugr'] = float((vp[vdis]==NORMAL_IDX).mean()) if vdis.any() else float('nan')\n            loaded[m][s] = {'scan': ds, 'vol': dv, 'pt': pt,\n                            'scan_pt': {str(p): g for p, g in ds.groupby('patient')},\n                            'vol_pt':  {str(p): g for p, g in dv.groupby('patient')}}\n\n    df_seedwise = pd.DataFrame(seed_rows)\n    df_seedwise.to_csv(os.path.join(output_dir, 'm2_seedwise_breakdown.csv'), index=False)\n\n    # Paired N=33 Patient Bootstrap (identical draws across every method)\n    methods_present = list(loaded.keys())\n    ref_s = next(iter(next(iter(loaded.values())).values()))\n    pids  = sorted(ref_s['scan_pt'].keys()); n_pts = len(pids)\n    dis_pts     = [p for p in pids if not math.isnan(ref_s['pt'][p]['ugr'])]\n    dis_vol_pts = [p for p in pids if not math.isnan(ref_s['pt'][p]['vol_ugr'])]\n\n    rng = np.random.default_rng(boot_seed)\n    draws = rng.integers(0, n_pts, size=(B, n_pts))\n    boot, pt_est = {}, {}\n    for m in methods_present:\n        sl = sorted(loaded[m].keys())\n        sub_s = df_seedwise[df_seedwise['method'] == m]\n        pt_est[m] = {\n            'n_seeds': len(sl), 'seeds': sl,\n            **{f'{k}_mean': float(sub_s[k].mean()) for k in ['scan_acc_pct','scan_f1','scan_auc_pct','scan_ugr_pct','vol_acc_pct','vol_f1','vol_auc_pct','vol_ugr_pct']},\n            **{f'{k}_std':  float(sub_s[k].std(ddof=1)) if len(sl)>1 else 0.0 for k in ['scan_acc_pct','scan_f1','scan_auc_pct','scan_ugr_pct','vol_acc_pct','vol_f1','vol_auc_pct','vol_ugr_pct']},\n        }\n        ba = {k: np.zeros(B) for k in ['s_acc','s_f1','s_auc','s_ugr','v_acc','v_f1','v_auc','v_ugr']}\n        for b in range(B):\n            prep = [pids[i] for i in draws[b]]\n            rs_l = [ _pool_metrics(pd.concat([loaded[m][s]['scan_pt'][p] for p in prep], ignore_index=True), False) for s in sl ]\n            rv_l = [ _pool_metrics(pd.concat([loaded[m][s]['vol_pt'][p]  for p in prep], ignore_index=True), True, mode) for s in sl ]\n            rs_a, rv_a = np.nanmean(rs_l, axis=0), np.nanmean(rv_l, axis=0)\n            ba['s_acc'][b], ba['s_f1'][b], ba['s_auc'][b], ba['s_ugr'][b] = rs_a\n            ba['v_acc'][b], ba['v_f1'][b], ba['v_auc'][b], ba['v_ugr'][b] = rv_a\n        boot[m] = ba\n\n    def _pvec(m, key, subset):\n        sl = sorted(loaded[m].keys())\n        return np.array([np.mean([loaded[m][s]['pt'][p][key] for s in sl]) for p in subset], dtype=float)\n\n    def _wil(x, y):\n        diff = x - y; n_eff = int(np.sum(np.abs(diff) > 1e-12))\n        if n_eff == 0: return 1.0, 0\n        return float(scipy_stats.wilcoxon(x, y, zero_method='wilcox', alternative='two-sided').pvalue), n_eff\n\n    def _pair(m1, m2):\n        pa, na   = _wil(_pvec(m1,'acc',pids),         _pvec(m2,'acc',pids))\n        pu, nu   = _wil(_pvec(m1,'ugr',dis_pts),      _pvec(m2,'ugr',dis_pts))\n        pva, nva = _wil(_pvec(m1,'vol_acc',pids),     _pvec(m2,'vol_acc',pids))\n        pvu, nvu = _wil(_pvec(m1,'vol_ugr',dis_vol_pts), _pvec(m2,'vol_ugr',dis_vol_pts))\n        df1  = boot[m1]['s_f1']  - boot[m2]['s_f1']\n        dauc = boot[m1]['s_auc'] - boot[m2]['s_auc']\n        pf1  = float(min(1.0, 2.0*(min(np.sum(df1<=0), np.sum(df1>=0))+1)/(B+1)))\n        pauc = float(min(1.0, 2.0*(min(np.sum(dauc<=0), np.sum(dauc>=0))+1)/(B+1)))\n        return {'n_pts_acc': n_pts, 'neff_acc': na, 'p_raw_acc': pa,\n                'n_pts_ugr': len(dis_pts), 'neff_ugr': nu, 'p_raw_ugr': pu,\n                'neff_vol_acc': nva, 'p_raw_vol_acc': pva,\n                'n_pts_vol_ugr': len(dis_vol_pts), 'neff_vol_ugr': nvu, 'p_raw_vol_ugr': pvu,\n                'p_boot_f1_raw': pf1, 'p_boot_auc_raw': pauc}\n\n    # (1) All-Pairs (M*(M-1)/2) Holm matrix\n    all_pairs = []\n    for i in range(len(methods_present)):\n        for j in range(i+1, len(methods_present)):\n            st = _pair(methods_present[i], methods_present[j])\n            st.update({'method_a': methods_present[i], 'method_b': methods_present[j]})\n            all_pairs.append(st)\n    if all_pairs:\n        for rk, ak in [('p_raw_acc','p_adj_acc'),('p_raw_ugr','p_adj_ugr'),('p_raw_vol_acc','p_adj_vol_acc'),\n                       ('p_raw_vol_ugr','p_adj_vol_ugr'),('p_boot_f1_raw','p_adj_f1'),('p_boot_auc_raw','p_adj_auc')]:\n            for r, v in zip(all_pairs, holm_bonferroni([x[rk] for x in all_pairs])): r[ak] = v\n        pd.DataFrame(all_pairs).to_csv(os.path.join(output_dir, 'm2_all_pairwise_holm_matrix.csv'), index=False)\n\n    # (2) TRIAGE vs All Comparators + Table S1\n    comps = [m for m in methods_present if m != 'triage']\n    pdet = {}\n    if 'triage' in loaded and comps:\n        for m in comps: pdet[m] = _pair('triage', m)\n        for rk, ak in [('p_raw_acc','p_adj_acc'),('p_raw_ugr','p_adj_ugr'),('p_raw_vol_acc','p_adj_vol_acc'),\n                       ('p_raw_vol_ugr','p_adj_vol_ugr'),('p_boot_f1_raw','p_adj_f1'),('p_boot_auc_raw','p_adj_auc')]:\n            for m, v in zip(comps, holm_bonferroni([pdet[m][rk] for m in comps])): pdet[m][ak] = v\n\n    sum_rows, tex_s1 = [], []\n    print(f'\\n================ M2 REPORT (N={n_pts} pts, {len(dis_pts)} diseased, B={B}, seeds={ {m:pt_est[m][\"seeds\"] for m in methods_present} }) ================')\n    for m in methods_present:\n        pe, bd, pd_i = pt_est[m], boot[m], pdet.get(m, {})\n        c_acc  = np.nanpercentile(bd['s_acc'], [2.5, 97.5]) * 100\n        c_f1   = np.nanpercentile(bd['s_f1'],  [2.5, 97.5])\n        c_auc  = np.nanpercentile(bd['s_auc'], [2.5, 97.5]) * 100\n        c_ugr  = np.nanpercentile(bd['s_ugr'], [2.5, 97.5]) * 100\n        c_vacc = np.nanpercentile(bd['v_acc'], [2.5, 97.5]) * 100\n        c_vugr = np.nanpercentile(bd['v_ugr'], [2.5, 97.5]) * 100\n        row = {'method': m, **pe, 'scan_acc_ci_lo': c_acc[0], 'scan_acc_ci_hi': c_acc[1],\n               'scan_f1_ci_lo': c_f1[0], 'scan_f1_ci_hi': c_f1[1], 'scan_auc_ci_lo': c_auc[0], 'scan_auc_ci_hi': c_auc[1],\n               'scan_ugr_ci_lo': c_ugr[0], 'scan_ugr_ci_hi': c_ugr[1], 'vol_acc_ci_lo': c_vacc[0], 'vol_acc_ci_hi': c_vacc[1],\n               'vol_ugr_ci_lo': c_vugr[0], 'vol_ugr_ci_hi': c_vugr[1], **pd_i}\n        sum_rows.append(row)\n        p_txt = f'Acc p_adj={pd_i[\"p_adj_acc\"]:.4f}(Neff={pd_i[\"neff_acc\"]}) UGR p_adj={pd_i[\"p_adj_ugr\"]:.4f}(Neff={pd_i[\"neff_ugr\"]})' if pd_i else 'REFERENCE'\n        print(f'  {m:20s} | Acc={pe[\"scan_acc_pct_mean\"]:5.2f}±{pe[\"scan_acc_pct_std\"]:4.2f}% [{c_acc[0]:5.2f},{c_acc[1]:5.2f}] | '\n              f'UGR={pe[\"scan_ugr_pct_mean\"]:5.2f}% [{c_ugr[0]:5.2f},{c_ugr[1]:5.2f}] | VolUGR={pe[\"vol_ugr_pct_mean\"]:5.2f}% | {p_txt}')\n        pf = lambda v: '$<0.001$' if v < 0.001 else f'${v:.