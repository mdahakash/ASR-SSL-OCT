del = FlatEffNet(NUM_CLASSES, True).to(DEVICE); params = model.parameters()\n        if fam == 'freematch': sat = SelfAdaptiveThreshold(DEVICE)\n        elif fam == 'flexmatch': cpl = FlexMatchCPL(len(udf))\n\n    ema_model = ModelEMA(DEVICE, model, MT_EMA_DECAY if fam=='meanteacher' else EMA_DECAY)\n    opt = torch.optim.SGD(params, lr=OPT_LR, momentum=OPT_MOM, weight_decay=OPT_WD, nesterov=OPT_NESTEROV)\n    sch = _lr_sched(opt, total_steps)\n    scaler = torch.amp.GradScaler('cuda', enabled=USE_CUDA_AMP)\n\n    print(f'\\n>>> TRAINING {tag} (steps={total_steps}, split_seed={SPLIT_SEED}, model_seed={model_seed}, amp={USE_CUDA_AMP})')\n    t0, best_score, lam = time.time(), -1.0, float(CRC_LAMBDA_GRID[0])\n    li, ui = iter(l_loader), (iter(u_loader) if u_loader is not None else None)\n    cov_sum, cov_n = 0.0, 0\n\n    for step in tqdm(range(1, total_steps + 1), desc=tag, dynamic_ncols=True):\n        model.train()\n        if vol_mod is not None: vol_mod.train()\n        try: dx = next(li)\n        except StopIteration: li = iter(l_loader); dx = next(li)\n        if ui is not None:\n            try: du = next(ui)\n            except StopIteration: ui = iter(u_loader); du = next(ui)\n\n        opt.zero_grad(set_to_none=True)\n        if fam == 'triage':\n            out = triage_step(dx, du, model, vol_mod, lam, capt, dual, bank, step, spec, DEVICE)\n        elif fam == 'sup':\n            with torch.amp.autocast('cuda', enabled=USE_CUDA_AMP):\n                lx_logits = model(dx[0].to(DEVICE, non_blocking=True))[0].float()\n            lx = F.cross_entropy(lx_logits, dx[1].to(DEVICE, non_blocking=True))\n            out = {'loss': lx, 'mask_prob': torch.tensor(1.0, device=DEVICE)}\n        elif fam == 'pseudolabel':\n            ix = dx[0].to(DEVICE, non_blocking=True); tx = dx[1].to(DEVICE, non_blocking=True)\n            iu = du[0].to(DEVICE, non_blocking=True)\n            with torch.amp.autocast('cuda', enabled=USE_CUDA_AMP):\n                lg, _ = model(t