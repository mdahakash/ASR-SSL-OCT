tag}.csv')\n\n    # Check if already finished in output_dir or any attached PREVIOUS_SEED_DIRS\n    for d in [output_dir] + list(PREVIOUS_SEED_DIRS):\n        if not d or not os.path.isdir(d): continue\n        ph = glob.glob(os.path.join(d, '**', f'preds_{tag}.csv'), recursive=True)\n        vh = glob.glob(os.path.join(d, '**', f'vol_preds_{tag}.csv'), recursive=True)\n        if SKIP_IF_DONE and ph and vh:\n            print(f'[SKIP] {tag} already found in {d}')\n            return ph[0], vh[0]\n\n    gen = torch.Generator(); gen.manual_seed(model_seed)\n    ldf, udf, vdf, cdf, tdf = splits['labeled'], splits['unlabeled'], splits['val'], splits['calib'], splits['test']\n\n    if fam == 'sup':\n        t_tr = pd.concat([ldf, udf], ignore_index=True) if spec['oracle'] else ldf\n        tds = LabeledOCTDataset(t_tr, is_weak=True)\n        l_loader = DataLoader(tds, sampler=RandomSampler(tds, generator=gen), batch_size=BATCH_SIZE_LABELED*(1+MU),\n                              num_workers=NUM_WORKERS, drop_last=True, pin_memory=PIN_MEMORY,\n                              persistent_workers=(NUM_WORKERS>0), worker_init_fn=_seed_worker)\n        u_loader = None\n    elif fam == 'triage':\n        tds = LabeledOCTDataset(ldf, is_weak=True)\n        uds = VolumeSequenceDataset(udf, WINDOW, spec['use_graph'])\n        l_loader = DataLoader(tds, sampler=RandomSampler(tds, generator=gen), batch_size=BATCH_SIZE_LABELED,\n                              num_workers=NUM_WORKERS, drop_last=True, pin_memory=PIN_MEMORY,\n                              persistent_workers=(NUM_WORKERS>0), worker_init_fn=_seed_worker)\n        u_loader = DataLoader(uds, sampler=RandomSampler(uds, generator=gen), batch_size=BATCH_SIZE_LABELED*MU,\n                              num_workers=NUM_WORKERS, drop_last=True, pin_memory=PIN_MEMORY,\n                              persistent_workers=(NUM_WORKERS>0), worker_init_fn=_seed_worker)\n    else:\n        um = {'pseudolabel': 'single_weak', 'meanteacher': 'w